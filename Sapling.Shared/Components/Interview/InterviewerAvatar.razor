@namespace Sapling.Shared.Components

@* Sapling AI, the interviewer. Blazor sets data-state; interview.js animates data-mouth while the voice plays. *@
<div class="iv-avatar" id="interviewer-avatar" data-state="@State" data-mouth="0" role="img"
     aria-label="@($"Interviewer, {Describe(State)}")">
    <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <defs>
            <clipPath id="iv-clip"><circle cx="100" cy="100" r="92" /></clipPath>
        </defs>

        <circle class="iv-ring" cx="100" cy="100" r="97" />
        <circle class="iv-bg" cx="100" cy="100" r="92" />

        <g clip-path="url(#iv-clip)">
            <path class="iv-hair" d="M60 94 C54 58 74 38 100 38 C126 38 146 58 140 94 L146 152 C128 164 72 164 54 152 Z" />
            <path class="iv-blazer" d="M28 204 C30 166 58 148 100 146 C142 148 170 166 172 204 Z" />
            <path class="iv-collar" d="M84 147 L100 178 L116 147 Z" />
            <rect class="iv-skin" x="89" y="116" width="22" height="36" rx="9" />
            <path class="iv-skin-shade" d="M89 124 C95 132 105 132 111 124 L111 132 C105 138 95 138 89 132 Z" />

            <g class="iv-head">
                <ellipse class="iv-skin" cx="66" cy="94" rx="6" ry="9" />
                <ellipse class="iv-skin" cx="134" cy="94" rx="6" ry="9" />
                <circle class="iv-earring" cx="66" cy="106" r="2.6" />
                <circle class="iv-earring" cx="134" cy="106" r="2.6" />

                <ellipse class="iv-skin" cx="100" cy="92" rx="34" ry="40" />
                <path class="iv-hair" d="M64 88 C60 58 80 46 100 46 C124 46 142 60 136 90 C130 72 118 62 102 62 C90 64 76 72 64 88 Z" />
                <path class="iv-hair" d="M100 48 C94 54 90 62 88 68 C96 60 104 56 114 54 Z" />

                <g class="iv-brows">
                    <path class="iv-stroke" d="M79 79 Q86 75 94 78" />
                    <path class="iv-stroke" d="M106 78 Q114 75 121 79" />
                </g>

                <g class="iv-eyes">
                    <ellipse class="iv-ink" cx="87" cy="90" rx="3.4" ry="3.9" />
                    <ellipse class="iv-ink" cx="113" cy="90" rx="3.4" ry="3.9" />
                </g>

                <path class="iv-stroke" style="stroke-width:1.6;opacity:.45" d="M100 95 Q97 104 101.5 106" />

                <g class="iv-m0">
                    <path d="M91 115 Q100 121 109 115" style="fill:none;stroke:#8E3F3A;stroke-width:2.6;stroke-linecap:round" />
                </g>
                <g class="iv-m1">
                    <ellipse class="iv-mouth-inside" cx="100" cy="116.5" rx="6.5" ry="2.8" />
                    <ellipse cx="100" cy="116.5" rx="6.5" ry="2.8" style="fill:none;stroke:#8E3F3A;stroke-width:1.8" />
                </g>
                <g class="iv-m2">
                    <ellipse class="iv-mouth-inside" cx="100" cy="117" rx="7.5" ry="4.6" />
                    <rect class="iv-teeth" x="94.5" y="112.8" width="11" height="2.4" rx="1" />
                    <ellipse cx="100" cy="117" rx="7.5" ry="4.6" style="fill:none;stroke:#8E3F3A;stroke-width:1.8" />
                </g>
                <g class="iv-m3">
                    <ellipse class="iv-mouth-inside" cx="100" cy="117.5" rx="8.5" ry="6.5" />
                    <rect class="iv-teeth" x="93.5" y="111.6" width="13" height="2.8" rx="1" />
                    <ellipse cx="100" cy="117.5" rx="8.5" ry="6.5" style="fill:none;stroke:#8E3F3A;stroke-width:1.8" />
                </g>
            </g>
        </g>

        <g class="iv-dots">
            <circle cx="152" cy="40" r="4.5" />
            <circle cx="165" cy="40" r="4.5" />
            <circle cx="178" cy="40" r="4.5" />
        </g>
    </svg>
</div>

@code {
    /// <summary>idle | speaking | listening | thinking</summary>
    [Parameter] public string State { get; set; } = "idle";

    private static string Describe(string state) => state switch
    {
        "speaking" => "speaking",
        "listening" => "listening to you",
        "thinking" => "thinking",
        _ => "waiting",
    };
}
