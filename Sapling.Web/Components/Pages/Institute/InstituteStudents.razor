@page "/institute/students"
@namespace Sapling.Web.Components.Pages.Institute
@layout InstituteLayout
@attribute [Authorize]
@inject InstituteService Institutes

<PageTitle>Students · Sapling</PageTitle>

<div class="stack g-5">
    <div class="page-head" style="margin-bottom:0">
        <div class="stack g-1">
            <span class="page-eyebrow hue-career">Your cohort</span>
            <h1 style="font-size:28px;line-height:34px">Students</h1>
            <span class="t-muted">Everyone who named your college on their profile.</span>
        </div>
        <a class="btn btn-secondary btn-sm" href="/api/institute/students.csv" data-enhance-nav="false">
            <SapIcon Name="download" Size="15" />
            Export CSV
        </a>
    </div>

    <div class="row g-2 wrap">
        <input class="input grow" style="min-width:220px" placeholder="Search name, email or branch"
               value="@_query" @oninput="OnQueryInput" />
        <select class="input" style="max-width:220px" @bind="_branch" @bind:after="ReloadAsync">
            <option value="">All branches</option>
            @foreach (var branch in _branches)
            {
                <option value="@branch">@branch</option>
            }
        </select>
        <select class="input" style="max-width:180px" @bind="_year" @bind:after="ReloadAsync">
            <option value="">All batches</option>
            @foreach (var year in _years)
            {
                <option value="@year">Class of @year</option>
            }
        </select>
    </div>

    @if (_students is null)
    {
        <div class="card"><div class="skeleton" style="height:220px"></div></div>
    }
    else if (_students.Count == 0)
    {
        <SapEmptyState Title="No students match" Icon="users" Art="search" Hue="career"
                       Description="Try clearing the filters, or check that your college name matches the one students search for." />
    }
    else
    {
        <div class="stack g-2">
            <span class="t-caption t-subtle">@_students.Count student@(_students.Count == 1 ? "" : "s")</span>
            @foreach (var student in _students)
            {
                <div class="card row-top g-3 hue-@Hues.ForKey(student.FullName)" @key="student.Id">
                    @if (!string.IsNullOrEmpty(student.AvatarDataUrl))
                    {
                        <img src="@student.AvatarDataUrl" alt="@student.FullName" class="avatar"
                             style="width:40px;height:40px;object-fit:cover;border-radius:var(--r-pill);flex:none" />
                    }
                    else
                    {
                        <span class="avatar" style="width:40px;height:40px;font-size:14px;flex:none">@Initials(student.FullName)</span>
                    }

                    <div class="grow stack g-2" style="min-width:0">
                        <div class="row between g-2 wrap">
                            <div class="stack" style="gap:2px;min-width:0">
                                <span style="font-weight:600">@student.FullName</span>
                                <span class="t-caption t-subtle">@student.Email</span>
                            </div>
                            <div class="row g-2 wrap">
                                <SapBadge Tone="neutral">@student.Branch</SapBadge>
                                <SapBadge Tone="info">Class of @student.GraduationYear</SapBadge>
                                @if (student.TargetRole is { } role)
                                {
                                    <SapBadge Tone="primary" Icon="target">@role</SapBadge>
                                }
                                @if (!student.OnboardingComplete)
                                {
                                    <SapBadge Tone="warn">Onboarding</SapBadge>
                                }
                            </div>
                        </div>

                        @if (student.Skills.Count > 0)
                        {
                            <div class="row g-1 wrap">
                                @foreach (var skill in student.Skills.Take(10))
                                {
                                    <span class="chip chip-hue t-caption">@skill</span>
                                }
                                @if (student.Skills.Count > 10)
                                {
                                    <span class="t-caption t-subtle">+@(student.Skills.Count - 10) more</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private IReadOnlyList<InstituteStudentDto>? _students;
    private IReadOnlyList<string> _branches = [];
    private IReadOnlyList<int> _years = [];

    private string _query = "";
    private string _branch = "";
    private string _year = "";
    private CancellationTokenSource? _debounce;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        // The filter lists come from the unfiltered first load, so they stay stable as the staffer narrows down.
        _branches = [.. _students!.Select(s => s.Branch).Distinct().Order()];
        _years = [.. _students!.Select(s => s.GraduationYear).Distinct().Order()];
    }

    private async Task ReloadAsync()
    {
        var year = int.TryParse(_year, out var parsed) ? parsed : (int?)null;
        _students = await Institutes.GetStudentsAsync(_query, _branch, year);
    }

    private async Task OnQueryInput(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? "";

        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        try
        {
            await Task.Delay(250, token);
            await ReloadAsync();
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
            // A newer keystroke took over.
        }
    }

    private static string Initials(string name) => string.Concat(
        name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
}
