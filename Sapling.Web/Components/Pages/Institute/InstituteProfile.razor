@page "/institute/profile"
@namespace Sapling.Web.Components.Pages.Institute
@layout InstituteLayout
@attribute [Authorize]
@inject InstituteService Institutes

<PageTitle>Institute profile · Sapling</PageTitle>

<div class="stack g-5" style="max-width:720px">
    <div class="page-head" style="margin-bottom:0">
        <div class="stack g-1">
            <span class="page-eyebrow hue-profile">Settings</span>
            <h1 style="font-size:28px;line-height:34px">Institute profile</h1>
            <span class="t-muted">How your college appears on every post and comment.</span>
        </div>
    </div>

    @if (_profile is null)
    {
        <div class="card"><div class="skeleton" style="height:220px"></div></div>
    }
    else
    {
        @if (_error is not null)
        {
            <div class="badge badge-error" role="alert" style="padding:10px 14px;border-radius:var(--r-md);white-space:normal">
                <SapIcon Name="alert-circle" Size="15" />
                @_error
            </div>
        }
        else if (_saved)
        {
            <div class="badge badge-success" role="status" style="padding:10px 14px;border-radius:var(--r-md)">Saved.</div>
        }

        <SapCard Class="tile hue-profile">
            <div class="row-top g-4 wrap">
                <button type="button" class="btn btn-ghost" style="padding:0;height:auto" @onclick="() => _editingLogo = true" title="Change logo">
                    @if (!string.IsNullOrEmpty(_profile.LogoDataUrl))
                    {
                        <img src="@_profile.LogoDataUrl" alt="@_profile.Name"
                             style="width:72px;height:72px;object-fit:cover;border-radius:var(--r-pill)" />
                    }
                    else
                    {
                        <span class="avatar" style="width:72px;height:72px;font-size:22px">@Initials</span>
                    }
                </button>

                <div class="grow stack g-2" style="min-width:220px">
                    <div class="row g-2 wrap">
                        <h4>@_profile.Name</h4>
                        @if (_profile.Verified)
                        {
                            <SapBadge Tone="success" Icon="shield-check">Verified</SapBadge>
                        }
                        else
                        {
                            <SapBadge Tone="warn" Icon="info">Awaiting verification</SapBadge>
                        }
                    </div>
                    <span class="t-small t-muted">
                        Verification is granted by Sapling; it puts a tick next to your name for students.
                    </span>
                    <button type="button" class="btn btn-secondary btn-sm" style="align-self:flex-start" @onclick="() => _editingLogo = true">
                        <SapIcon Name="camera" Size="14" />
                        Change logo
                    </button>
                </div>
            </div>
        </SapCard>

        <SapCard Title="Details" Class="card-accent hue-profile">
            <ChildContent>
            <div class="stack g-4">
                <div class="field">
                    <label for="name">College name</label>
                    <input id="name" class="input" @bind="_name" @bind:event="oninput" />
                    <span class="field-hint">
                        Students reach your community by naming this exact college, so change it only to correct it.
                    </span>
                </div>

                <div class="grid grid-2">
                    <div class="field">
                        <label for="short">Short name</label>
                        <input id="short" class="input" maxlength="24" @bind="_shortName" />
                    </div>
                    <div class="field">
                        <label for="state">State</label>
                        <select id="state" class="input" value="@_state" @onchange="OnStateChanged">
                            <option value="">Select a state</option>
                            @foreach (var state in LocationCatalog.GetStates())
                            {
                                <option value="@state">@state</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="grid grid-2">
                    <div class="field">
                        <label for="city">City</label>
                        <select id="city" class="input" @bind="_city" disabled="@string.IsNullOrEmpty(_state)">
                            <option value="">Select a city</option>
                            @foreach (var city in LocationCatalog.GetCitiesForState(_state))
                            {
                                <option value="@city">@city</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label for="contact">Contact email</label>
                        <input id="contact" type="email" class="input" @bind="_contactEmail" />
                    </div>
                </div>

                <div class="field">
                    <label for="website">Website</label>
                    <input id="website" class="input" @bind="_website" placeholder="https://college.ac.in" />
                </div>

                <div class="field">
                    <label for="about">About</label>
                    <textarea id="about" class="input" rows="4" maxlength="600" @bind="_about"
                              placeholder="A line or two students will read on your profile."></textarea>
                </div>
            </div>
            </ChildContent>

            <Footer>
                <div class="row g-2" style="justify-content:flex-end">
                    <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
                        @(_saving ? "Saving…" : "Save changes")
                    </button>
                </div>
            </Footer>
        </SapCard>
    }
</div>

@if (_editingLogo)
{
    <AvatarEditorModal CurrentAvatarUrl="@_profile?.LogoDataUrl" OnSave="SaveLogoAsync" OnClose="() => _editingLogo = false" />
}

@code {
    private InstituteProfileDto? _profile;
    private string _name = "";
    private string _shortName = "";
    private string _city = "";
    private string _state = "";
    private string _about = "";
    private string _website = "";
    private string _contactEmail = "";
    private string? _error;
    private bool _saving;
    private bool _saved;
    private bool _editingLogo;

    private string Initials => string.Concat(
        _name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));

    protected override async Task OnInitializedAsync() => Fill(await Institutes.FindProfileAsync());

    private void Fill(InstituteProfileDto? profile)
    {
        _profile = profile;
        if (profile is null)
        {
            return;
        }

        _name = profile.Name;
        _shortName = profile.ShortName;
        _city = profile.City;
        _state = profile.State;
        _about = profile.About;
        _website = profile.Website;
        _contactEmail = profile.ContactEmail;
    }

    private void OnStateChanged(ChangeEventArgs e)
    {
        _state = e.Value?.ToString() ?? "";
        _city = "";
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;
        _saved = false;
        try
        {
            Fill(await Institutes.UpdateProfileAsync(
                new UpdateInstituteRequest(_name, _shortName, _city, _state, _about, _website, _contactEmail)));
            _saved = true;
        }
        catch (Exception e) when (e is ArgumentException or InvalidOperationException)
        {
            _error = e.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveLogoAsync(string? dataUrl)
    {
        _editingLogo = false;
        _error = null;
        try
        {
            Fill(await Institutes.SetLogoAsync(dataUrl));
        }
        catch (ArgumentException e)
        {
            _error = e.Message;
        }
    }
}
