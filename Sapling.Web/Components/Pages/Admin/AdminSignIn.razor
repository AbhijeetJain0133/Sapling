@page "/admin/signin"
@namespace Sapling.Web.Components.Pages.Admin
@layout EmptyLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using Microsoft.AspNetCore.Components.Endpoints
@using Microsoft.AspNetCore.Identity
@using Sapling.Web.Data
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject NavigationManager Nav

<PageTitle>Admin sign in · Sapling</PageTitle>

<div class="stack center staff-signin" style="min-height:100vh;padding:var(--sp-5)">
    <div class="card stack g-5 auth-card-float" style="width:100%;max-width:400px">
        <div class="stack g-2">
            <SapLogo Size="30" WordSize="20" />
            <div class="stack g-1">
                <h3>Administrator sign in</h3>
                <span class="t-small t-subtle">Platform staff only.</span>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="badge badge-error" role="alert" style="padding:10px 14px;border-radius:var(--r-md);white-space:normal">
                <SapIcon Name="alert-circle" Size="15" />
                @_error
            </div>
        }

        <EditForm Model="Input" method="post" OnValidSubmit="SubmitAsync" FormName="admin-signin" class="stack g-4">
            <DataAnnotationsValidator />

            <div class="field">
                <label for="email">Email</label>
                <InputText id="email" class="input" @bind-Value="Input.Email" autocomplete="username" />
                <ValidationMessage For="() => Input.Email" class="field-error" />
            </div>

            <div class="field">
                <label for="password">Password</label>
                <InputText id="password" type="password" class="input" @bind-Value="Input.Password" autocomplete="current-password" />
                <ValidationMessage For="() => Input.Password" class="field-error" />
            </div>

            <button type="submit" class="btn btn-primary btn-block">Sign in</button>
        </EditForm>

        <div class="stack g-2" style="text-align:center">
            <a class="t-small" href="/signin">Back to student sign-in</a>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm] private SignInInput Input { get; set; } = default!;

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private string? _error;

    protected override void OnInitialized() => Input ??= new();

    private async Task SubmitAsync()
    {
        Input.Email = AccountFlowService.Clean(Input.Email);

        var user = await UserManager.FindByEmailAsync(Input.Email);
        if (user is not null && user.AccountType != AccountTypes.Admin)
        {
            _error = "That is not an administrator account.";
            return;
        }

        var result = await SignInManager.PasswordSignInAsync(Input.Email, Input.Password, isPersistent: true, lockoutOnFailure: false);
        if (!result.Succeeded)
        {
            _error = result.IsLockedOut && user is not null && AccountStatus.IsDeactivated(user)
                ? "This account has been deactivated."
                : result.IsLockedOut
                    ? "Too many attempts. Try again in a few minutes."
                    : "That email and password combination did not match.";
            return;
        }

        Nav.NavigateTo(string.IsNullOrWhiteSpace(ReturnUrl) ? "/admin" : ReturnUrl);
    }

    private sealed class SignInInput
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Enter your email.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "That does not look like an email address.")]
        public string Email { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Enter your password.")]
        public string Password { get; set; } = "";
    }
}
