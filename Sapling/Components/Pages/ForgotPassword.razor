@page "/forgot-password"
@namespace Sapling.Components.Pages
@layout AuthLayout
@attribute [AllowAnonymous]
@inject ApiAuthService Auth
@inject NavigationManager Nav

<PageTitle>Reset your password · Sapling</PageTitle>

<div class="stack g-4">
    <div class="stack g-1">
        <h3>Reset your password</h3>
        <span class="t-small t-subtle">@StepHint</span>
    </div>

    @if (_error is not null)
    {
        <div class="badge badge-error" role="alert" style="padding:10px 14px;border-radius:var(--r-md);white-space:normal">
            <SapIcon Name="alert-circle" Size="15" />
            @_error
        </div>
    }
    else if (_notice is not null)
    {
        <div class="badge badge-success" role="status" style="padding:10px 14px;border-radius:var(--r-md);white-space:normal">
            @_notice
        </div>
    }

    @switch (_step)
    {
        case Step.Email:
            <div class="field">
                <label for="email">Email</label>
                <input id="email" class="input" type="email" inputmode="email" autocomplete="email"
                       placeholder="you@college.ac.in" value="@_email" @oninput="OnEmailInput" @onkeydown="OnEnter" />
                <span class="field-hint">The email you registered with. We will send it a 6-digit code.</span>
            </div>

            <button type="button" class="btn btn-primary btn-block" @onclick="SendAsync" disabled="@_busy">
                @(_busy ? "Sending…" : "Send code")
            </button>
            break;

        case Step.Code:
            <div class="field">
                <label for="code">Verification code</label>
                <input id="code" class="input otp-input" inputmode="numeric" autocomplete="one-time-code" maxlength="6"
                       placeholder="000000" @bind="_code" @bind:event="oninput" @onkeydown="OnEnter" />
            </div>

            <button type="button" class="btn btn-primary btn-block" @onclick="VerifyAsync" disabled="@(_busy || _code.Trim().Length != 6)">
                @(_busy ? "Checking…" : "Verify")
            </button>

            <div class="row between g-2 wrap">
                <button type="button" class="btn btn-ghost btn-sm" @onclick="BackToEmail" disabled="@_busy">Use a different email</button>
                <button type="button" class="btn btn-ghost btn-sm" @onclick="ResendAsync" disabled="@_busy">Resend code</button>
            </div>
            break;

        case Step.Password:
            <div class="field">
                <label for="password">New password</label>
                <input id="password" class="input" type="password" autocomplete="new-password"
                       @bind="_password" @bind:event="oninput" @onkeydown="OnEnter" />
                <span class="field-hint">At least 8 characters, with an uppercase letter, a lowercase letter and a digit.</span>
            </div>

            <button type="button" class="btn btn-primary btn-block" @onclick="ResetAsync" disabled="@(_busy || _password.Length == 0)">
                @(_busy ? "Saving…" : "Set new password")
            </button>
            break;
    }

    <span class="t-small t-muted" style="text-align:center">
        Remembered it? <a href="/signin">Sign in</a>
    </span>
</div>

@code {
    private enum Step { Email, Code, Password }

    private Step _step = Step.Email;
    private string _email = "";
    private string _code = "";
    private string _ticket = "";
    private string _password = "";
    private string? _error;
    private string? _notice;
    private bool _busy;

    private string StepHint => _step switch
    {
        // Worded so it does not confirm whether an account exists for the address.
        Step.Code => $"If {_email} has a Sapling account, a 6-digit code is on its way. It expires in 10 minutes.",
        Step.Password => "Choose a new password. You will be signed in straight after.",
        _ => "We will email you a code to prove it is you.",
    };

    private void OnEmailInput(ChangeEventArgs e) => _email = (e.Value?.ToString() ?? "").Replace(" ", "").Trim();

    private async Task OnEnter(KeyboardEventArgs args)
    {
        if (args.Key != "Enter" || _busy)
        {
            return;
        }

        await (_step switch
        {
            Step.Email => SendAsync(),
            Step.Code => VerifyAsync(),
            _ => ResetAsync(),
        });
    }

    private Task SendAsync() => RunAsync(async () =>
    {
        var result = await Auth.SendCodeAsync(CodePurposes.ResetPassword, _email);
        _error = result.Error;
        if (result.Succeeded)
        {
            _code = "";
            _step = Step.Code;
        }
    });

    private Task ResendAsync() => RunAsync(async () =>
    {
        var result = await Auth.SendCodeAsync(CodePurposes.ResetPassword, _email);
        _error = result.Error;
        _notice = result.Succeeded ? "If the account exists, a new code is on its way. Only the latest code works." : null;
    });

    private Task VerifyAsync() => RunAsync(async () =>
    {
        var result = await Auth.VerifyCodeAsync(CodePurposes.ResetPassword, _email, _code.Trim());
        _error = result.Error;
        if (result.Succeeded)
        {
            _ticket = result.Ticket ?? "";
            _step = Step.Password;
        }
    });

    private Task ResetAsync() => RunAsync(async () =>
    {
        var result = await Auth.ResetPasswordAsync(_email, _ticket, _password);
        if (result.Succeeded)
        {
            Nav.NavigateTo("/home");
            return;
        }

        _error = result.Error;
        _password = "";
        if (result.Restart)
        {
            _step = Step.Email;
        }
    });

    private void BackToEmail()
    {
        _error = null;
        _notice = null;
        _code = "";
        _step = Step.Email;
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        _notice = null;

        try
        {
            await action();
        }
        catch (HttpRequestException)
        {
            _error = "Could not reach the Sapling server. Check that it is running and reachable from this device.";
        }
        finally
        {
            _busy = false;
        }
    }
}
